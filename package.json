{
  "name": "conference-manager-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/index.js",
    "db:migrate": "node scripts/db-migrate.mjs up",
    "db:rollback": "node scripts/db-migrate.mjs down",
    "operator:tenant": "node scripts/tenant-operator.mjs",
    "pilot:readiness": "node scripts/pilot-readiness.mjs --require-ready",
    "pilot:exchange-rbac": "node scripts/exchange-application-rbac-check.mjs",
    "check:syntax": "node scripts/check-syntax.mjs",
    "check:agents": "node scripts/check-agent-instructions.mjs",
    "check:architecture": "node scripts/check-architecture.mjs && node scripts/check-module-boundaries.mjs",
    "check:pilot-activation": "node scripts/check-pilot-activation.mjs",
    "check:pilot-operations": "node scripts/check-pilot-operations.mjs",
    "check:pilot-readiness": "node scripts/pilot-readiness.mjs docs/pilot-readiness-evidence.example.json",
    "check:multi-tenant": "node scripts/check-multi-tenant-isolation.mjs",
    "check:application-contract": "node scripts/check-production-application-contract.mjs",
    "check:jit": "node scripts/check-jit-user-provisioning.mjs",
    "check:roles": "node scripts/check-tenant-user-administration.mjs",
    "check:microsoft365": "node scripts/check-microsoft365-connection.mjs",
    "check:entitlements": "node scripts/check-entitlements.mjs",
    "check:booking": "node scripts/check-booking-integration.mjs",
    "check:observability": "node scripts/check-observability.mjs",
    "check:security-baseline": "node scripts/check-security-baseline.mjs",
    "check:dependencies": "node scripts/check-dependencies.mjs",
    "check:static": "node scripts/check-static.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:style": "node scripts/check-style.mjs",
    "test": "node --test tests/*.test.js",
    "test:db": "node --test --test-concurrency=1 tests-db/*.test.js",
    "test:dast": "node scripts/security-dast.mjs",
    "check": "npm run check:syntax && npm run check:agents && npm run check:architecture && npm run check:pilot-activation && npm run check:pilot-operations && npm run check:pilot-readiness && npm run check:multi-tenant && npm run check:application-contract && npm run check:jit && npm run check:roles && npm run check:microsoft365 && npm run check:entitlements && npm run check:booking && npm run check:observability && npm run check:security-baseline && npm run check:dependencies && npm run check:static && npm run check:secrets && npm run check:style && npm test && npm run test:dast",
    "audit": "npm audit --audit-level=high"
  },
  "dependencies": {
    "@azure/msal-node": "5.4.3",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "es-module-lexer": "2.3.2"
  }
}
